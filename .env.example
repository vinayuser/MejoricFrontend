# Copy to .env and fill values for this branch
# Vite only exposes vars prefixed with VITE_
# NEVER put secrets here (Razorpay secret, Agora certificate, JWT, DB passwords)

SKIP_PREFLIGHT_CHECK=true
CI=false

# Deploy base path: /  or  /staging/
VITE_BASE=/

# local | production
VITE_APP_ENV=local

VITE_ALLOW_MOCK_PAYMENTS=false
VITE_IS_STAGING=false

# TEMP only — skip camera/mic for Agora connection testing
VITE_SKIP_MEDIA_PERMISSION=false

# API base (include /mateandmentors)
# Local:   http://localhost:3002/mateandmentors
# Prod:    https://mejoric.com/mateandmentors
# Staging: https://mejoric.com/staging-api/mateandmentors
VITE_API_BASE_URL=

# Socket.IO origin (no path prefix)
# Local:   http://localhost:3002
# Prod:    https://mejoric.com
# Staging: https://mejoric.com/staging-api
VITE_SOCKET_SERVER_URL=

VITE_GA_ID=
VITE_PIXEL_ID=

# Seconds — match backend TRIAL_CHAT_DURATION
VITE_TRIAL_CHAT_DURATION=600

VITE_VIDEO_CALL_PRICE_PER_MIN=15
VITE_AUDIO_CALL_PRICE_PER_MIN=12
VITE_CHAT_PRICE_PER_MIN=8
VITE_FREE_WALLET_RECHARGE=100

# Legacy EnableX URLs (optional; Agora is used for live mate calls)
VITE_VIDEO_CALL_BASE_URL=https://mateandmentors.yourvideo.live/host/
VITE_AUDIO_CALL_BASE_URL=https://matenmentor.yourvideo.live/host/

# Razorpay public key id (backend: RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=

# Agora public app id (backend: AGORA_APP_ID)
# Do NOT put AGORA_APP_CERTIFICATE in frontend
VITE_AGORA_APP_ID=
VITE_AGORA_TOKEN_TTL_SECONDS=86400

# Firebase Cloud Messaging VAPID key
VITE_FCM_VAPID_KEY=

# Optional Node static server port
PORT=6001
